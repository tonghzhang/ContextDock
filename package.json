{
  "name": "contextdock",
  "version": "0.2.0",
  "private": true,
  "description": "Save your workspace. Resume it in one click.",
  "author": "ContextDock contributors",
  "license": "MIT",
  "type": "module",
  "main": "dist/main.cjs",
  "bin": {
    "contextdock": "dist/cli.cjs",
    "contextdock-mcp": "dist/mcp.cjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "test:e2e": "node scripts/smoke.mjs",
    "start": "electron .",
    "cli": "node dist/cli.cjs",
    "mcp": "node dist/mcp.cjs",
    "dist": "npm run build && electron-builder --win nsis portable --x64 --publish never",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "predist": "node -e \"require('electron')\"",
    "test:e2e:languages": "node scripts/languages-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "44.4.5",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.27.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.5.0",
    "playwright": "^1.58.0",
    "prettier": "^3.8.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.55.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.18"
  }
}
